# 4thwall WAF - Environment variables
# Copy to .env and adjust as needed

# API
API_HOST=0.0.0.0
API_PORT=8000

# Model – HuggingFace Hub repo ID (or a local directory path like models/huggingface_model or models/v2_1b)
MODEL_PATH=viitheone/4thwall-waf-v2.1b

# Multi-threading for CPU inference
TORCH_THREADS=4

# Logs
NGINX_ACCESS_LOG=./logs/access.log
DECISION_LOG=./logs/decision_log.json
RETRAIN_LOG=./logs/retrain_log.json

# Upstream protected web application (DVWA)
DVWA_URL=http://dvwa:80
